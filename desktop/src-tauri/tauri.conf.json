{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "REETA",
  "version": "1.0.0",
  "identifier": "ai.reeta.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "REETA — Responsive Executive Engine for Tasks and Automation",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "REETA Systems",
    "copyright": "Copyright © 2026 REETA",
    "shortDescription": "Autonomous Personal AI Operating System for Windows 11",
    "externalBin": [
      "binaries/reeta-backend"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
