# ==============================================================================
# REETA Environment Configuration Template
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8765
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=generate_a_random_32_byte_secret_key_here

# PostgreSQL & pgvector Database
DATABASE_URL=postgresql+asyncpg://reeta_admin:reeta_secure_password_2026@127.0.0.1:5432/reeta_db
POSTGRES_USER=reeta_admin
POSTGRES_PASSWORD=reeta_secure_password_2026
POSTGRES_DB=reeta_db
POSTGRES_PORT=5432

# Model Gateway & Providers
DEFAULT_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3.1:latest

# Cloud LLM API Keys (Optional - only required if using cloud models)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Vector Embeddings
EMBEDDING_PROVIDER=local # 'local' (sentence-transformers) or 'openai'
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Voice & Speech Pipeline
VOICE_ENABLED=true
STT_MODEL_SIZE=base.en # tiny.en, base.en, small.en
TTS_ENGINE=edge-tts # 'piper' or 'edge-tts'
EDGE_TTS_VOICE=en-US-AriaNeural
WAKE_WORD=Hey Reeta
VAD_THRESHOLD=0.5

# Automation & Sandboxing
AUTHORIZED_WORKSPACE=E:/PROJECTS/reeta — responsive executive engine for tasks and automation
DOCKER_SANDBOX_ENABLED=true
PLAYWRIGHT_HEADLESS=false
UI_AUTOMATION_TIMEOUT_MS=15000

# Security & Approvals
APPROVAL_TICKET_TTL_SECONDS=300
REQUIRE_APPROVAL_FOR_HOST_TERMINAL=true
REQUIRE_APPROVAL_FOR_FILE_DELETION=true
REQUIRE_APPROVAL_FOR_EXTERNAL_NETWORK=true
